# Vendra Commercial Platform & Multi-Tenant POS
# Official Domain: vendra.charafeddine.xyz
# LiteSpeed & Apache Production Configuration

DirectoryIndex index.html index.php

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security: Protect backend database files and credentials
    RewriteRule ^config/ - [F,L]
    RewriteRule \.(sql|sqlite|sqlite3|db|env|log|key)$ - [F,L]

    # 1. Central Vendor Licensing API
    RewriteRule ^license-api/(.*)$ license-api/index.php [QSA,L]
    RewriteRule ^license-api$ license-api/index.php [QSA,L]

    # 2. Universal POS Client Backend API (Multi-Tenant Aware)
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # 3. Web Installer
    RewriteRule ^install/(.*)$ install/$1 [L]
    RewriteRule ^install$ install/ [R=301,L]

    # 4. Uploads
    RewriteRule ^uploads/(.*)$ uploads/$1 [L]

    # 5. Direct App & Static Asset Resolution
    RewriteRule ^app/ - [L]
    RewriteRule ^assets/(.*)$ app/assets/$1 [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 6. Commercial Showcase Landing Page (Root /)
    RewriteRule ^$ index.html [L]

    # 7. Customer Live Test Routing:
    # Any customer company path (e.g. /al-shams, /solar, /demo, /solar-tech)
    RewriteCond %{REQUEST_URI} !^/(api|license-api|install|uploads|config|database|app|dist) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-zA-Z0-9_-]+/?$ app/index.html [L]

    RewriteCond %{REQUEST_URI} !^/(api|license-api|install|uploads|config|database|app|dist) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)/(.*)$ app/$2 [QSA,L]

    # Fallback to showcase landing page
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript application/json text/css text/html text/plain text/xml image/svg+xml
</IfModule>
